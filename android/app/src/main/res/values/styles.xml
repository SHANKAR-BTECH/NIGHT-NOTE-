<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#0d1b3e</item>
        <item name="colorPrimaryDark">#0d1b3e</item>
        <item name="colorAccent">#f5c842</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">#0d1b3e</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0d1b3e</item>
        <item name="android:windowBackground">#0d1b3e</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:statusBarColor">#0d1b3e</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#0d1b3e</item>
    </style>
</resources>
